[Unit]
Description=SINAGERSAT API REST (FastAPI)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=climbat
Group=climbat
WorkingDirectory=/home/climbat/SINAGERSAT/BaseData
ExecStart=/home/climbat/SINAGERSAT/BaseData/venv/bin/uvicorn api.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
Environment=PATH=/home/climbat/SINAGERSAT/BaseData/venv/bin:/usr/bin:/bin
EnvironmentFile=/home/climbat/SINAGERSAT/BaseData/.env

[Install]
WantedBy=multi-user.target
