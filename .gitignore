# ================================================================
# MONOREPO servidorProsuco - .gitignore global
# ================================================================

# ----- Python -----
*.pyc
*.pyo
*.pyd
__pycache__/
*.so
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
*.egg-info/
dist/
build/
pip-wheel-metadata/

# ----- Entornos virtuales -----
venv/
env/
.venv/
virtualenv/
*.venv/

# ----- Variables de entorno y secretos -----
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
.keys/

# ----- Node.js / Frontend -----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.lintstagedrc
.eslintcache
dist/
build/
.next/
.out/
*.tsbuildinfo
.vite/

# ----- IDE / Editores -----
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.sublime-project
*.sublime-workspace

# ----- Logs -----
*.log
logs/
*.out

# ----- Bases de datos y backups -----
*.sql
*.dump
*.backup
backups/
*.sqlite
*.db

# ----- Archivos grandes / Binarios -----
*.zip
*.tar.gz
*.rar
*.7z
*.gguf
*.bin
*.elf
*.hex
*.model
*.weights

# ----- PlatformIO / Embedded -----
.pio/
.pioenvs/
.fingerprint
*.bin
*.elf
*.hex
*.uf2

# ----- OS -----
.DS_Store
ehthumbs.db
Desktop.ini

# ----- Proyecto específico: SINAGERSAT -----
SINAGERSAT/BaseData/venv/
SINAGERSAT/BaseData/uploads/reports/**/*
!SINAGERSAT/BaseData/uploads/reports/.gitkeep
SINAGERSAT/BaseData/.env
SINAGERSAT/BaseData/*.log
SINAGERSAT/BaseData/BaseData.zip
SINAGERSAT/admin-panel/node_modules/
SINAGERSAT/admin-panel/dist/
SINAGERSAT/admin-panel/.env*

# ----- Proyecto específico: AgriAgent -----
AgriAgent/firmware/esp32_agri/.pio/
AgriAgent/firmware/esp32_agri/build/
AgriAgent/firmware/esp32_agri_arduino/build/

# ----- Proyecto específico: MotorIA -----
MotorIA/venv/
MotorIA/backups/
MotorIA/.keys/
MotorIA/KEYS_BACKUP.md
MotorIA/docs_anterior/
MotorIA/modelos/*.gguf
MotorIA/modelos/*.bin
MotorIA/*.log